# User Service Configuration
PORT=3001
SERVICE_NAME=user-service
REQUEST_BODY_LIMIT=5mb

# Database
MONGODB_URI=mongodb://localhost:27017/mallify

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET="9Njz9dl1@"
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET="9Njz9dl1@"
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback

# Email (for OTP and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=false
FROM_NAME=Mallify
FROM_EMAIL=noreply@mallify.com

# Environment
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
